Процедура УстановитьТокенВПараметрыСеанса() Экспорт
    // Получаем уникальный идентификатор текущего пользователя
    УникальныйИдентификаторПользователя = ПолучитьТекущегоПользователя();
    
    Если УникальныйИдентификаторПользователя = Неопределено Тогда
        Сообщить("Текущий пользователь не определен!");
        Возврат;
    КонецЕсли;
    
    // Получаем путь к файлу токена для этого пользователя
    Путь = ПолучитьПутьКТокену(УникальныйИдентификаторПользователя);
    
    Если ПустаяСтрока(Путь) Тогда
        Сообщить("Не найден файл токена для текущего пользователя!");
        Возврат;
    КонецЕсли;
    
    Попытка
        // Читаем токен из файла
        Токен = ПрочитатьТокенИзФайла(Путь);
        
        Если ПустаяСтрока(Токен) Тогда
            Сообщить("Токен пустой!");
            Возврат;
        КонецЕсли;
        
        // Устанавливаем токен в параметры сеанса
        УстановитьТокенВПараметрыСеанса();  
        Сообщить("Токен успешно установлен в сеанс.");
    Исключение
        Сообщить("Ошибка загрузки токена: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

