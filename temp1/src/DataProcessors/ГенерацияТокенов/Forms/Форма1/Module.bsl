// ================= КЛИЕНТ =================
&НаКлиенте
Процедура ПриОткрытии(Отказ)
    // Получаем путь к файлу токена с сервера
    ПутьКТокену = ПолучитьПутьКФайлуТокена();
    Если ПустаяСтрока(ПутьКТокену) Тогда
        Сообщить("Путь к файлу токена не получен!");
        Возврат;
    КонецЕсли;

    // Читаем токен на клиенте
    Токен = ПрочитатьТокенСФайла(ПутьКТокену);
    Если Не ПустаяСтрока(Токен) Тогда
        ПередатьТокенНаСервер(Токен);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьТокенСФайла(Путь)
    Попытка
        Док = Новый ТекстовыйДокумент;
        Док.Прочитать(Путь, КодировкаТекста.UTF8);
        Токен = СокрЛП(Док.ПолучитьТекст());

        Если ПустаяСтрока(Токен) Тогда
            Сообщить("Файл токена пустой!");
            Возврат "";
        КонецЕсли;

        Возврат Токен;
    Исключение
        Сообщить("Ошибка чтения токена: " + ОписаниеОшибки());
        Возврат "";
    КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПередатьТокенНаСервер(Токен)
    УстановитьТокенВСеансСервер(Токен);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаГенерировать(Команда)
    ЧасыTTL = ВводTTL;

    Если ТипЗнч(ЧасыTTL) <> Тип("Число") Или ЧасыTTL <= 0 Тогда
        Сообщить("Введите корректное положительное число часов TTL");
        Возврат;
    КонецЕсли;

    Попытка
        НовыйТокен = СерверГенерацияТокена(ЧасыTTL);
        Если ПустаяСтрока(НовыйТокен) Тогда
            Сообщить("Ошибка генерации токена!");
        Иначе
            Элементы.ПолеТокен.Значение = НовыйТокен;
            Сообщить("Токен сгенерирован");
        КонецЕсли;
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// ================= СЕРВЕР =================
&НаСервере
Функция ПолучитьПутьКФайлуТокена()
    ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Пользователи.Токен
    |ИЗ
    |   Справочник.Пользователи КАК Пользователи
    |ГДЕ
    |   Пользователи.Наименование = &Имя";
    Запрос.УстановитьПараметр("Имя", ТекущийПользователь.Имя);

    Результат = Запрос.Выполнить().Выбрать();
    Если Результат.Следующий() Тогда
        Возврат СокрЛП(Результат.Токен);
    КонецЕсли;

    Возврат "";
КонецФункции

&НаСервере
Процедура УстановитьТокенВСеансСервер(Токен)
    ПараметрыСеанса.Токен = Токен;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СерверГенерацияТокена(ЧасыTTL)
    Адрес = Константы.АдресХранилища.Получить();
    Порт = Число(Константы.ПортХранилища.Получить());
    Токен = ПараметрыСеанса.Токен; // токен администратора

    Если ПустаяСтрока(Адрес) Или ПустаяСтрока(Токен) Тогда
        Возврат "";
    КонецЕсли;

    Соединение = Новый HTTPСоединение(Адрес, Порт);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("X-Vault-Token", Токен);
    Заголовки.Вставить("Content-Type", "application/json");

    TTL = Формат(ЧасыTTL, "ЧГ=") + "h";
    Тело = "{""ttl"":""" + TTL + """}";

    ЗапросHTTP = Новый HTTPЗапрос("/v1/auth/token/create");
    ЗапросHTTP.Заголовки = Заголовки;
    ЗапросHTTP.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);

    Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
    Если Ответ.КодСостояния <> 200 Тогда
        Возврат "";
    КонецЕсли;

    JSON = Новый ЧтениеJSON;
    JSON.Поток = Новый ПотокВПамяти;
    JSON.Записать(Ответ.ПолучитьТелоКакСтроку());
    Данные = JSON.Прочитать();
    Возврат Данные.auth.client_token;
КонецФункции
