&НаКлиенте
Процедура ПользовательВыборПриИзменении(Элемент)
	Если ПользовательВыбор = Неопределено Или ПустаяСтрока(ПользовательВыбор) Тогда
	    Возврат;
	КонецЕсли;


    // Чтение токена из файла
    Путь = ПолучитьПутьКФайлу(ПользовательВыбор.УникальныйИдентификатор());
    Если ПустаяСтрока(Путь) Тогда
        Сообщить("Путь к файлу токена не указан.");
        Возврат;
    КонецЕсли;

    Попытка
        Док = Новый ТекстовыйДокумент;
        Док.Прочитать(Путь, КодировкаТекста.UTF8);
        Токен = СокрЛП(Док.ПолучитьТекст());
        Если ПустаяСтрока(Токен) Тогда
   			 Сообщить("Файл токена пустой или некорректный.");
   		Возврат;
		КонецЕсли;
        

        // Установка токена в сеансе
        УстановитьТокенВСеанс(Токен);
        Сообщить("Токен установлен.");
    Исключение
        Сообщить("Ошибка чтения токена: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура КнопкаГенерировать(Команда)
    Токен = ПолучитьТокенИзСеанса();
    Если ПустаяСтрока(Токен) Тогда
        Сообщить("Токен не установлен. Выберите пользователя.");
        Возврат;
    КонецЕсли;

    Если ВводTTL <= 0 Тогда
        Сообщить("Некорректный TTL.");
        Возврат;
    КонецЕсли;

    НовыйТокен = ГенерироватьОграниченныйТокен(ВводTTL);
    Если ПустаяСтрока(НовыйТокен) Тогда
        Сообщить("Ошибка генерации токена.");
    Иначе
        ПолеТокен = НовыйТокен;
        Сообщить("Новый токен сгенерирован.");
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьТокенВСеанс(НовыйТокен) Экспорт
    // Записываем строку прямо в параметр сеанса
    ПараметрыСеанса.Токен = НовыйТокен;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТокенИзСеанса() Экспорт
    // Проверяем, что параметр задан и непустой
    Если ЗначениеЗаполнено(ПараметрыСеанса.Токен) Тогда
        Возврат ПараметрыСеанса.Токен;
    КонецЕсли;
    Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ГенерироватьОграниченныйТокен(TTL_Часы) Экспорт
    Адрес = Константы.АдресХранилища.Получить();
    Порт = Число(Константы.ПортХранилища.Получить());
    Токен = ПолучитьТокенИзСеанса();

    Если ПустаяСтрока(Адрес) Или ПустаяСтрока(Токен) Тогда
        Возврат "";
    КонецЕсли;

    Соединение = Новый HTTPСоединение(Адрес, Порт);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("X‑Vault‑Token", Токен);
    Заголовки.Вставить("Content‑Type", "application/json");

    TTL = Формат(TTL_Часы, "ЧГ=") + "h";
    Тело = "{""ttl"":""" + TTL + """}";

    Запрос = Новый HTTPЗапрос("/v1/auth/token/create");
    Запрос.Заголовки = Заголовки;
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);

    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        Возврат "";
    КонецЕсли;

    JSON = Новый ЧтениеJSON;
    JSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(JSON);
    Возврат Данные.auth.client_token;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПутьКФайлу(UID) Экспорт
    Ссылка = Справочники.Пользователи.ПолучитьСсылку(UID);
    Если Ссылка = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Объект = Ссылка.ПолучитьОбъект();
    Возврат СокрЛП(Объект.Токен);
КонецФункции
