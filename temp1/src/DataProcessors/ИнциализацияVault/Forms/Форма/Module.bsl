&НаСервереБезКонтекста
Функция ПолучитьПараметрыVault() Экспорт
    Возврат Новый Структура(
        "Адрес,Порт,Токен",
        Константы.АдресХранилища.Получить(),
        Константы.ПортХранилища.Получить(),
        ПолучитьТекущийТокен()  // <-- берем из сеанса, а не из констант
    );
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущийТокен() Экспорт
    Если ЗначениеЗаполнено(ПараметрыСеанса.Токен) Тогда
        Возврат ПараметрыСеанса.Токен;
    КонецЕсли;
КонецФункции


&НаКлиенте
Процедура ПриОткрытии(Отказ, СтандартнаяОбработка)
    Перем ПараметрыVault;
    ПараметрыVault = ПолучитьПараметрыVault();

    // Прямо в модель формы присваиваем значение
    ЭтаФорма.АдресVault = ПараметрыVault.Адрес;
    ЭтаФорма.Порт       = ПараметрыVault.Порт;
    ЭтаФорма.Token      = ПараметрыVault.Токен;
КонецПроцедуры



&НаСервере
Процедура СохранитьПараметрыНаСервере(Адрес, Порт, Токен) Экспорт
    Константы.АдресХранилища.Установить(Адрес);
    Константы.ПортХранилища.Установить(Порт);
    Константы.ТокенVault.Установить(Токен);
