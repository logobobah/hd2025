&НаСервереБезКонтекста
Функция ПолучитьПараметрыVault() Экспорт
    Возврат Новый Структура(
        "Адрес,Порт,Токен",
        Константы.АдресХранилища.Получить(),
        Константы.ПортХранилища.Получить(),
        ПолучитьТекущийТокен()
    );
КонецФункции
&НаСервереБезКонтекста
Функция ПолучитьТекущийТокен() Экспорт
    Попытка
        Если ЗначениеЗаполнено(ПараметрыСеанса.Токен) Тогда
            Возврат ПараметрыСеанса.Токен;
        КонецЕсли;
    Исключение
        // Токен ещё не инициализирован — просто возвращаем пусто
    КонецПопытки;
    Возврат "";
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ, СтандартнаяОбработка)
    ПараметрыФ = ПолучитьПараметрыVault();
    ЭтаФорма.АдресVault = ПараметрыФ.Адрес;
    ЭтаФорма.Порт       = ПараметрыФ.Порт;
    ЭтаФорма.Token      = ПараметрыФ.Токен;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСекрет(Команда)
    Если ПустаяСтрока(ПутьСекрета) Или ПустаяСтрока(Ключ) Или ПустаяСтрока(ЗначениеСекрета) Тогда
        Сообщить("Заполните Путь, Ключ и Значение.");
        Возврат;
    КонецЕсли;
    Попытка
        СохранитьСекретНаСервере(ПутьСекрета, Ключ, ЗначениеСекрета);
        Сообщить("Секрет сохранён.");
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьСекрет(Команда)
    Если ПустаяСтрока(ПутьСекрета) Тогда
        Сообщить("Укажите путь к секрету.");
        Возврат;
    КонецЕсли;
    Попытка
        Данные = ПрочитатьСекретНаСервере(ПутьСекрета);
        Если ТипЗнч(Данные) = Тип("Структура") Тогда
            Если Данные.Количество() = 1 Тогда
                Для Каждого П Из Данные Цикл
                    Ключ = П.Ключ;
                    ЗначениеСекрета = П.Значение;
                КонецЦикла;
            Иначе
                Сообщить("Несколько значений:");
                Для Каждого П Из Данные Цикл
                    Сообщить(П.Ключ + ": " + П.Значение);
                КонецЦикла;
            КонецЕсли;
        Иначе
            Сообщить("Формат ответа неверен.");
        КонецЕсли;
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьСекретНаСервере(Путь, Ключ, Значение) Экспорт
    // Проверка токена
    Токен = ПолучитьТекущийТокен();
    Если ПустаяСтрока(Токен) Тогда
        ВызватьИсключение("Токен не задан");
    КонецЕсли;

    // KV v2 требует префикс /data/ и полного пути ключа
    ПолныйПуть = Путь;
    Если ПустаяСтрока(Ключ) = Ложь Тогда
        // Если ключ указан, формируем полный путь
        ПолныйПуть = Путь + "/" + Ключ;
    КонецЕсли;

    // ИЗМЕНЕНИЕ 1: Используем правильный путь к движку (kv вместо secret)
    URL = "/v1/kv/data/" + ПолныйПуть;

    // Формируем тело запроса для KV v2
    JSONЗапись = Новый ЗаписьJSON;
    JSONЗапись.УстановитьСтроку();
    ЗаписатьJSON(
        JSONЗапись,
        Новый Структура(
            "data",
            Новый Структура("значение", Значение)
        )
    );
    Тело = JSONЗапись.Закрыть();

    // Создаём HTTP-запрос
    HTTPЗапрос = Новый HTTPЗапрос(URL);
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
    HTTPЗапрос.Заголовки.Вставить("X-Vault-Token", Токен);
    HTTPЗапрос.УстановитьТелоИзСтроки(Тело, "UTF-8");

    Соедин = Новый HTTPСоединение(
        Константы.АдресХранилища.Получить(),
        Число(Константы.ПортХранилища.Получить())
    );

    Ответ = Соедин.ВызватьHTTPМетод("PUT", HTTPЗапрос);

    Если НЕ (Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 204) Тогда
        ВызватьИсключение("Vault: " + Ответ.КодСостояния + " — " + Ответ.ПолучитьТелоКакСтроку());
    КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ПрочитатьСекретНаСервере(Путь) Экспорт
    Токен = ПолучитьТекущийТокен();
    Если ПустаяСтрока(Токен) Тогда
        ВызватьИсключение("Токен не задан");
    КонецЕсли;

    URL = "/v1/secret/data/" + Путь;
    HTTPЗапрос = Новый HTTPЗапрос(URL);
    HTTPЗапрос.Заголовки.Вставить("X-Vault-Token", Токен);

    Соедин = Новый HTTPСоединение(
        Константы.АдресХранилища.Получить(),
        Число(Константы.ПортХранилища.Получить())
    );
    Ответ = Соедин.ВызватьHTTPМетод("GET", HTTPЗапрос);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение("Vault: " + Ответ.КодСостояния + " — " + Ответ.ПолучитьТелоКакСтроку());
    КонецЕсли;

    Текст = Ответ.ПолучитьТелоКакСтроку();
    Чт = Новый ЧтениеJSON;
    Чт.УстановитьСтроку(Текст);
    Объект = ПрочитатьJSON(Чт);

    Если НЕ (Объект.Свойство("data") И Объект.data.Свойство("data")) Тогда
        ВызватьИсключение("Некорректный ответ: отсутствует data.data");
    КонецЕсли;

    Возврат Объект.data.data;
КонецФункции

