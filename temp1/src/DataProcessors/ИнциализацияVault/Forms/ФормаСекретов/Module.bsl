&НаКлиенте
Процедура СохранитьСекрет(Команда)
    Если ПустаяСтрока(ПутьСекрета) Или 
       ПустаяСтрока(Ключ) Или 
       ПустаяСтрока(ЗначениеСекрета) Тогда
        Сообщить("Заполните Путь, Ключ и Значение перед сохранением секрета.");
        Возврат;
    КонецЕсли;

    Попытка
        СохранитьСекретНаСервере(
            ПутьСекрета,
            Ключ,
            ЗначениеСекрета,
            АдресVault,
            Порт,
            Token
        );
        Сообщить("Секрет успешно сохранён.");
    Исключение
        Сообщить("Ошибка сохранения: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьСекрет(Команда)
    Если ПустаяСтрока(ПутьСекрета) Тогда
        Сообщить("Укажите Путь к секрету перед чтением.");
        Возврат;
    КонецЕсли;

    Попытка
        Данные = ПрочитатьСекретНаСервере(
            ПутьСекрета,
            АдресVault,
            Порт,
            Token
        );

        // Если один ключ — заполняем элементы формы
        Если ТипЗнч(Данные) = Тип("Структура") Тогда
            Если Данные.Количество() = 1 Тогда
                Для Каждого Пара Из Данные Цикл
                    Ключ = Пара.Ключ;
                    ЗначениеСекрета = Пара.Значение;
                КонецЦикла;
            Иначе
                Сообщить("Секрет содержит несколько значений:");
                Для Каждого Пара Из Данные Цикл
                    Сообщить("Ключ: " + Пара.Ключ + " → " + Пара.Значение);
                КонецЦикла;
            КонецЕсли;
        Иначе
            Сообщить("Неподдерживаемый формат ответа от Vault.");
        КонецЕсли;

    Исключение
        Сообщить("Ошибка чтения: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры


&НаСервере
Процедура СохранитьСекретНаСервере(Путь, Ключ, Значение, АдресVault, ПортVault, RootToken) Экспорт
    Если ПустаяСтрока(Путь) Или ПустаяСтрока(Ключ) Или ПустаяСтрока(Значение) Тогда
        ВызватьИсключение "Путь, ключ и значение обязательны.";
    КонецЕсли;

    URL = "/v1/secret/data/" + Путь;
    Хост = АдресVault;
    Порт = Число(ПортVault);

    // Формируем тело запроса
    ДанныеСекрета = Новый Структура;
    ДанныеСекрета.Вставить(Ключ, Значение);

    ТелоJSON = Новый Структура;
    ТелоJSON.Вставить("data", ДанныеСекрета);

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ТелоJSON);
    Тело = ЗаписьJSON.Закрыть();

    Запрос = Новый HTTPЗапрос(URL);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
    Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
    Запрос.Заголовки.Вставить("X-Vault-Token", RootToken);

    Соединение = Новый HTTPСоединение(Хост, Число(Порт));
    Ответ = Соединение.ВызватьHTTPМетод("PUT", Запрос);

    Если НЕ (Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 204) Тогда
        ВызватьИсключение "Vault вернул ошибку: " + Ответ.КодСостояния + " — " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ПрочитатьСекретНаСервере(ПутьСекр, АдресVault, ПортVault, RootToken) Экспорт
    URL = "/v1/secret/data/" + ПутьСекр;
    Хост = АдресVault;
    Порт = Число(ПортVault);

    Запрос = Новый HTTPЗапрос(URL);
    Запрос.Заголовки.Вставить("X-Vault-Token", RootToken);

    Соединение = Новый HTTPСоединение(Хост, число(Порт));
    Ответ = Соединение.ВызватьHTTPМетод("GET", Запрос);

    Если Ответ.КодСостояния = 200 Тогда
        JSON = Ответ.ПолучитьТелоКакСтроку();
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(JSON);
        Объект = ПрочитатьJSON(Чтение);

        // KV v2 → путь: data.data
        Если Объект.Свойство("data") И Объект.data.Свойство("data") Тогда
            Возврат Объект.data.data;
        Иначе
            ВызватьИсключение "Невалидный ответ от Vault: отсутствует поле data.data";
        КонецЕсли;
    Иначе
        ВызватьИсключение "Ошибка чтения секрета. Код: " + Ответ.КодСостояния + " — " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;
КонецФункции


