&НаСервереБезКонтекста
Функция ПолучитьПараметрыVault() Экспорт
    Возврат Новый Структура(
        "Адрес,Порт,Токен",
        Константы.АдресХранилища.Получить(),
        Константы.ПортХранилища.Получить(),
        ПолучитьТекущийТокен()  // <-- берем из сеанса, а не из констант
    );
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущийТокен() Экспорт
    Если ЗначениеЗаполнено(ПараметрыСеанса.Токен) Тогда
        Возврат ПараметрыСеанса.Токен;
    КонецЕсли;
КонецФункции


&НаКлиенте
Процедура ПриОткрытии(Отказ, СтандартнаяОбработка)
    Перем ПараметрыVault;
    ПараметрыVault = ПолучитьПараметрыVault();

    // Прямо в модель формы присваиваем значение
    ЭтаФорма.АдресVault = ПараметрыVault.Адрес;
    ЭтаФорма.Порт       = ПараметрыVault.Порт;
    ЭтаФорма.Token      = ПараметрыVault.Токен;
КонецПроцедуры


&НаКлиенте
Процедура Отмена(Команда)
    Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Распечатать(Команда)
    // Проверка — ничего не ввели
    Если ЭтаФорма.ТаблицаКлючей.Количество() = 0 Тогда
        Сообщить("Не введено ни одного ключа.");
        Возврат;
    КонецЕсли;

    // Копируем в массив структур
    ЛокальныйМассив = Новый Массив;

    Для Каждого Строка Из ЭтаФорма.ТаблицаКлючей Цикл
        Если ПустаяСтрока(Строка.Ключ) Тогда
            Сообщить("Обнаружен пустой ключ. Операция отменена.");
            Возврат;
        КонецЕсли;
        ЛокальныйМассив.Добавить(Новый Структура("Ключ", Строка.Ключ));
    КонецЦикла;

    // Передача на сервер
    Если РаспечататьНаСервере(
            ЭтаФорма.АдресVault,
            ЭтаФорма.Порт,
            ЭтаФорма.Token,
            ЛокальныйМассив
    ) Тогда
        Сообщить("Хранилище успешно распечатано.");
        Закрыть();
    Иначе
        Сообщить("Ошибка при распечатке.");
    КонецЕсли;
КонецПроцедуры



&НаСервере
Функция РаспечататьНаСервере(Адрес, Порт, Токен, ТаблицаКлючей) Экспорт
    Перем Успешно, Соединение, Заголовки, HTTPЗапрос, ДанныеJSON, Ответ, Строка;
    Успешно = Истина;

    Попытка
        Соединение = Новый HTTPСоединение(Адрес, Число(Порт));
        Заголовки   = Новый Соответствие;
        Заголовки.Вставить("X-Vault-Token", Токен);

        Для Каждого Строка Из ТаблицаКлючей Цикл
            HTTPЗапрос = Новый HTTPЗапрос("/v1/sys/unseal", Заголовки);
            ДанныеJSON = "{""key"":""" + Строка.Ключ + """}";
            HTTPЗапрос.УстановитьТелоИзСтроки(ДанныеJSON, "UTF-8");

            Ответ = Соединение.ВызватьHTTPМетод("PUT", HTTPЗапрос);
            Если Ответ.КодСостояния <> 200 Тогда
                Сообщить("Ошибка применения ключа: " + Строка.Ключ + 
                         " — " + Ответ.КодСостояния);
                Успешно = Ложь;
            КонецЕсли;
        КонецЦикла;
    Исключение
        Сообщить("Ошибка при распечатке: " + ОписаниеОшибки());
        Успешно = Ложь;
    КонецПопытки;

    Возврат Успешно;
КонецФункции
